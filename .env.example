# Hepsi isteğe bağlı. Boş bırakılırsa varsayılan kullanılır.

# Ekranın açılacağı kapı numarası
PORT=5055

# Canlı kayıt dosyasının klasörü (varsayılan: %LOCALAPPDATA%\Hal_Otomasyonu)
# HAL_VERI_KLASORU=C:\HalVeri

# Yedeklerin klasörü (varsayılan: proje içindeki yedekler)
# HAL_YEDEK_KLASORU=C:\HalYedek

# Sadece internette çalışırken gerekir, Render ekranına yazılır.
# Kayıtların durduğu veri servisinin bağlantı adresi
# DATABASE_URL=postgresql://kullanici:parola@adres/veritabani
# Programa girerken sorulacak şifre
# APP_SIFRE=buraya-uzun-bir-sifre
# Oturumları koruyan rastgele yazı (Render kendisi üretir)
# HAL_GIZLI=rastgele-uzun-yazi
